# Local dev: copy this file to .env and fill the values.
# Production: set these in Netlify → Site configuration → Environment variables.

# Anthropic API key for the ARC intake agent.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Calendar OAuth (used by schedule_call to book Adrián's calendar).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Resend (used by send_transcript to email hello@arcmediahouse.com).
RESEND_API_KEY=
# Optional overrides — useful while the domain is not yet verified in Resend.
# Default from is agent@arcmediahouse.com, default to is hello@arcmediahouse.com.
# RESEND_FROM=onboarding@resend.dev
# RESEND_TO=hello@arcmediahouse.com

# Supabase (used to log every conversation turn for the admin log page).
# Project URL and SERVICE ROLE key (server-side only — never expose to client).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Password gating /admin.html. Pick something long.
ADMIN_PASSWORD=
